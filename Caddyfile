# Reverse proxy for docker-compose.prod.yml.
# DOMAIN and ACME_EMAIL come from .env (passed to the caddy service).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Keep in line with OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB (default 100).
	request_body {
		max_size 110MB
	}

	# API docs (Swagger / ReDoc) live on the API port, outside the /api/*
	# prefix Next.js forwards. Public by design: the schema is readable by
	# anyone, but calls still need the password (Authorize → Bearer).
	@apidocs path /docs /docs/* /redoc /openapi.json
	reverse_proxy @apidocs open_notebook:5055

	reverse_proxy open_notebook:8502 {
		# Stream chat / widget answers (Server-Sent Events) without buffering.
		flush_interval -1
		# Long-running operations (transformations, podcasts).
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
