# Production settings for docker-compose.prod.yml
# Copy to .env on the server and fill in. Never commit the real .env.

# =============================================================================
# DOMAIN / HTTPS
# =============================================================================

# Public hostname (DNS A/AAAA record must point at this server)
DOMAIN=notebook.example.com
# Email for Let's Encrypt expiry notices
ACME_EMAIL=admin@example.com

# Public URL of the app (no trailing /api)
API_URL=https://notebook.example.com
# Used for cloud sync OAuth redirects (Dropbox / Google Drive)
OPEN_NOTEBOOK_PUBLIC_URL=https://notebook.example.com

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================

# Encrypts AI provider credentials in the database. Generate with:
#   openssl rand -base64 32
# Back it up separately: if lost, stored credentials become unreadable.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Login password. Auth is fully disabled if unset. Generate with:
#   openssl rand -base64 24
OPEN_NOTEBOOK_PASSWORD=

# =============================================================================
# DATABASE (internal only, but still use real credentials)
# =============================================================================

SURREAL_USER=notebook
SURREAL_PASSWORD=
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# BEHIND THE REVERSE PROXY
# =============================================================================

# Caddy overwrites X-Forwarded-For, so the widget rate limit can trust it
OPEN_NOTEBOOK_TRUST_FORWARDED_FOR=true

# Keep Caddyfile request_body max_size above this
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# =============================================================================
# OPTIONAL
# =============================================================================

# Cloud sync app credentials (can also be set in the UI)
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Heavy extraction runtimes, installed on first startup (cached in notebook_data)
# OPEN_NOTEBOOK_ENABLE_DOCLING=true
# OPEN_NOTEBOOK_ENABLE_CRAWL4AI=true

# Concurrent background tasks (default 5)
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=5

# NEVER enable OPEN_NOTEBOOK_AI_DEBUG in production: it logs prompts and answers.
